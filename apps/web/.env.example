# Copie para .env (não commitar .env). Em prod, configure na Vercel → Project Settings → Environment Variables.
# Dev local (Vite proxy usa /api)
VITE_API_URL=http://localhost:3000/api
# Prod exemplo: VITE_API_URL=https://api.nutritheone.com.br/api
# Fallback Vercel sem domínio: VITE_API_URL=https://nutrigest-api.onrender.com/api
